#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/led/led.h>

#define CALC 0
#define APPS 1
#define GAME 2
#define RGB_BT 3
#define ORTHO_L 4
#define TIMEOUT 75
#define FN 5

/ {
    behaviors {
        fn_key: fn_key {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
        fn_return: fn_return {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&to>;
        };
        fn_ortho: fn_ortho {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&to APPS>, <&to GAME>;
        };
        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <500>;
            bindings = <&kp LC(LS(NUMBER_1))>, <&kp LC(LS(N2))>, <&kp LC(LS(N3))>;
        };
        qts: quotes {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&dqts>, <&sqts>;
        };
    };
    macros {
        triple_zero: triple_zero {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <15>;
            tap-ms = <15>;
            bindings = <&kp NUMBER_0 &kp NUMBER_0 &kp NUMBER_0>;
        };
        prts: parentheses {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <15>;
            tap-ms = <15>;
            bindings = <&kp LPAR &kp RPAR>, <&kp LEFT>;
        };
        dqts: double_quotes {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <15>;
            tap-ms = <15>;
            bindings = <&kp DQT &kp DQT>, <&kp LEFT>;
        };
        sqts: single_quotes {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <15>;
            tap-ms = <15>;
            bindings = <&kp SQT &kp SQT>, <&kp LEFT>;
        };
    };
    combos {
        compatible = "zmk,combos";
        combo_JPKey {
            timeout-ms = <TIMEOUT>;
            key-positions = <11 13>;
            bindings = <&kp LA(GRAVE)>;
        };
    };
    keymap {
        compatible = "zmk,keymap";
        calc_layer {
            bindings = <
                &none                      &fn_key FN F19 &kp ASTERISK   &kp SLASH       &mt ESC BACKSPACE
                &none                      &kp NUMBER_7   &kp NUMBER_8   &kp NUMBER_9    &kp PLUS
                &none                      &kp NUMBER_4   &kp NUMBER_5   &kp NUMBER_6    &kp MINUS
                &mt LC(LA(LS(E))) C_MUTE   &kp NUMBER_1   &kp NUMBER_2   &kp NUMBER_3    &kp ENTER
                &td0                       &kp NUMBER_0   &triple_zero   &mt COMMA DOT   &kp ENTER
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
        apps_layer {
            bindings = <
                &none    &fn_return FN CALC               &kp F13                &kp F14                          &kp F15
                &none    &kp F16                &kp F17                &kp F18                          &kp LC(PG_UP)
                &none    &kp LC(LS(NUMBER_1))   &kp LC(LS(NUMBER_2))   &mt LA(GRAVE) LC(LS(NUMBER_3))   &kp LC(PG_DN)
                &trans   &prts                  &qts 0 0               &kp LG(LS(RIGHT))                &kp ENTER
                &trans   &kp LC(X)              &kp LC(C)              &kp LC(LS(V))                    &kp ENTER
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
        game_layer {
            bindings = <
                &none    &fn_return FN CALC         &kp F13     &kp F14     &kp F15
                &none    &kp KP_N7        &kp KP_N8   &kp KP_N9   &kp LC(PG_UP)
                &none    &kp KP_N4        &kp KP_N5   &kp KP_N6   &kp LC(PG_DN)
                &trans   &kp KP_N1        &kp KP_N2   &kp KP_N3   &kp LC(LS(ENTER))
                &trans   &kp KP_NUMLOCK   &kp KP_N0   &kp DOT     &kp ENTER
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
        rgb_bt_layer {
            bindings = <
                &none    &fn_return FN CALC          &rgb_ug RGB_TOG   &rgb_ug RGB_EFF   &rgb_ug RGB_SPI
                &none    &rgb_ug RGB_HUI   &rgb_ug RGB_SAI   &rgb_ug RGB_BRI   &rgb_ug RGB_SPD
                &none    &rgb_ug RGB_HUD   &rgb_ug RGB_SAD   &rgb_ug RGB_BRD   &rgb_ug RGB_SPD
                &trans   &bt BT_NXT        &bt BT_PRV        &bt BT_CLR        &ext_power EP_TOG
                &trans   &none             &none             &none             &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
        ORTHO_L {
            bindings = <
                &none    &fn_ortho FN T &kp G   &kp B   &kp SPACE
                &none    &kp R   &kp F   &kp V   &kp LALT
                &none    &kp E   &kp D   &kp C   &kp LWIN
                &trans   &kp W   &kp S   &kp X   &kp LCTRL
                &trans   &kp Q   &kp A   &kp Z   &kp LCTRL
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
        fn_layer {
            bindings = <
                &trans   &trans       &trans       &sys_reset    &bootloader
                &trans   &bt BT_NXT   &bt BT_PRV   &bt BT_CLR    &trans
                &trans   &to RGB_BT   &to ORTHO_L  &trans        &trans
                &trans   &to CALC     &to APPS     &to GAME      &trans
                &trans   &rgb_ug RGB_TOG &trans    &trans        &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
